{
  "name": "business-and-chats-pilot",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "render:framework:office": "remotion render src/index.tsx FrameworkOffice out/framework-batch1/office.mp4 --scale=0.4 --concurrency=2",
    "render:framework:storefront": "remotion render src/index.tsx FrameworkStorefront out/framework-batch1/storefront.mp4 --scale=0.4 --concurrency=2",
    "studio": "remotion studio src/index.tsx --no-open",
    "typecheck": "tsc --noEmit",
    "render:draft": "remotion render src/index.tsx BusinessShort out/merger-draft.mp4 --props=examples/merger.json --concurrency=2",
    "still": "remotion still src/index.tsx BusinessShort out/merger-still.png --props=examples/merger.json --frame=660",
    "render:anthropic:storyboard": "remotion render src/index.tsx AnthropicShort out/anthropic-storyboard.mp4 --concurrency=2",
    "still:anthropic": "remotion still src/index.tsx AnthropicShort out/anthropic-still.png --frame=1150",
    "render:host-concept-c": "remotion render src/index.tsx HostConceptCReview out/host-concept-c/compare.mp4 --scale=0.4 --codec=h264 --concurrency=2",
    "render:host-concept-c-acting": "remotion render src/index.tsx HostConceptCActingProof out/host-concept-c/acting.mp4 --scale=0.4 --codec=h264 --concurrency=2",
    "render:host-concept-c-receipt": "remotion render src/index.tsx HostConceptCReceiptProof out/host-concept-c/receipt.mp4 --scale=0.4 --codec=h264 --concurrency=2",
    "still:host-concept-c-cameo": "remotion still src/index.tsx HostConceptCCameo out/host-concept-c/cameo.png --frame=0 --scale=0.4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "remotion": "4.0.539",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
